# Local application
PORT=8080
VAIKAPARTS_FRONTEND_BASE_URL=http://localhost:3000

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vaikaparts
SPRING_DATASOURCE_USERNAME=vaikaparts
SPRING_DATASOURCE_PASSWORD=replace-me

# Supabase Auth and auth webhook
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=replace-me
SUPABASE_WEBHOOK_SECRET=replace-me
SUPABASE_DISCOVERY_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# RabbitMQ
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
SPRING_RABBITMQ_VHOST=/
SPRING_RABBITMQ_QUEUE=vaikaparts
SPRING_RABBITMQ_EXCHANGE=vaikaparts
SPRING_RABBITMQ_ROUTING_KEY=vaikaparts
SPRING_RABBITMQ_PORT=5672
APP_RABBITMQ_SSL=false

# S3-compatible object storage (Backblaze B2 in deployed environments)
CLOUD_STORAGE_KEY_ID=replace-me
CLOUD_STORAGE_APPLICATION_KEY=replace-me
CLOUD_STORAGE_BUCKET_NAME=replace-me
CLOUD_STORAGE_FULL_ENDPOINT=https://s3.example.com
CLOUD_STORAGE_REGION=us-east-1

# SMTP. The current EmailConf requires these settings at startup.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_USERNAME=replace-me
SPRING_MAIL_PASSWORD=replace-me
SPRING_MAIL_FROM_EMAIL=notifications@example.com
SPRING_MAIL_PORT=1025

# Contact unlock and PAPI
ENABLE_CONTACT_PAYMENT=true
CONTACT_UNLOCK_PRICE_MGA=3000
CONTACT_UNLOCK_ORANGE_MONEY_NUMBER=
PECUNIA_BASE_URL=
PECUNIA_API_KEY=
PECUNIA_CONNECT_TIMEOUT=5s
PECUNIA_REQUEST_TIMEOUT=10s

# External notifications. A user preference must also enable the channel.
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_WEB_PUSH_ENABLED=false
NOTIFICATIONS_WEB_PUSH_DISPATCH_ENABLED=false
BEFIANA_SMS_BASE_URL=
BEFIANA_SMS_API_KEY=
SMS_CONNECT_TIMEOUT=5s
SMS_REQUEST_TIMEOUT=10s

# Web Push. Keep the dispatch secret identical to the Web App secret.
PUSH_DISPATCH_URL=http://localhost:3000/api/push/dispatch
PUSH_DISPATCH_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@vaikaparts.mg

# Optional worker tuning
CONTACT_RELEASE_RETRY_MAX_ATTEMPTS=3
CONTACT_RELEASE_RETRY_INITIAL_INTERVAL_MS=1000
CONTACT_RELEASE_RETRY_MULTIPLIER=2.0
CONTACT_RELEASE_RETRY_MAX_INTERVAL_MS=10000
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CONFIRM_TIMEOUT=5s
OUTBOX_INITIAL_BACKOFF=2s
OUTBOX_MAX_BACKOFF=5m
OUTBOX_LEASE_DURATION=30s
